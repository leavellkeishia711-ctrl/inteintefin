PROJECT_NAME="FinanceIntel Backend"
API_V1_STR="/api/v1"
DATABASE_URL="postgresql+asyncpg://financeintel:secret_password@db:5432/financeintel"
DATABASE_URL_MIGRATIONS="postgresql+asyncpg://financeintel:secret_password@db:5432/financeintel"
APP_USER_DATABASE_URL="postgresql+asyncpg://app_user:app@db:5432/financeintel"
ECHO_SQL=False
DB_POOLER_MODE=False
DB_SSLMODE="require"

REDIS_URL="redis://redis:6379/0"
CELERY_BROKER_URL="redis://redis:6379/0"

SECRET_KEY="generate_a_strong_secret_key_here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

ENVIRONMENT="production"
CORS_ORIGINS=["https://app.financeintel.co"]
COOKIE_SECURE=True

AI_PROVIDER="anthropic"
AI_MODEL="claude-3-haiku-20240307"
AI_API_KEY="dummy_key_for_ci"

TELEGRAM_BOT_TOKEN="dummy_bot_token"
TELEGRAM_WEBHOOK_SECRET="test_secret"

# Frontend Next.js (not in backend config, but needed for compose)
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
NEXT_PUBLIC_FEATURE_MI=false
